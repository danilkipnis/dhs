# Build stamp for the generated table-vi files (see Makefile). The files it
# guards are committed; the stamp only records when they were last produced.
.table-vi.stamp

# Editor swap files
.*.sw[a-p]

# npm dependencies (e.g. playwright)
node_modules/

# Book-style renderings of the 1984 book's pages live on the local
# book-style-renderings branch, not here. Ignored so that recreating one in this
# working tree cannot slip it into the public history via `git add -A`.
chapter-5.html
table-*.html
tables.css
chapter-5-source.md
